# Used by `docker compose -f docker-compose.prod.yml build/up` (copy to .env).
#
# IMPORTANT: SHELL_URL / FIRST_APP_URL / SECOND_APP_URL / PUBLIC_SHOW_EVENT_DEBUGGER
# are passed as Docker BUILD ARGS, not runtime env vars — Module Federation
# asset prefixes and remote URLs are baked into the JS bundle at build time.
# Changing any of these requires `docker compose -f docker-compose.prod.yml build`,
# a plain `restart`/`up` will keep serving the old baked-in URLs.

# Host port the reverse proxy binds to (container always listens on 8080 internally).
HTTP_PORT=8080

# Public origin of the reverse proxy — replace with your real domain in production.
# No trailing slash on any of these.
SHELL_URL=http://localhost:8080
FIRST_APP_URL=http://localhost:8080/first-app
SECOND_APP_URL=http://localhost:8080/second-app

# Shows the floating Events debugger widget in the shell UI. Keep "false" in prod.
PUBLIC_SHOW_EVENT_DEBUGGER=false
